<list type="glossary" xml:id="glossario_critico">
    <head>Glossario Unificato: Istituzioni, Norme e Concetti</head>

    <label>
        <term type="org" xml:id="Min_Istruzione">Ministero della Pubblica Istruzione</term>
    </label>
    <item>
        <gloss corresp="#Min_Istruzione">Organo centrale del governo italiano preposto all'amministrazione del sistema scolastico nazionale.</gloss>
    </item>

    <label>
        <term type="org" xml:id="CPS">Consiglio Provinciale Scolastico</term>
    </label>
    <item>
        <gloss corresp="#CPS">Ente locale incaricato della gestione e della vigilanza sulle scuole della provincia.</gloss>
    </item>

    <label>
        <term type="org" xml:id="Consiglio_Istr">Consiglio Superiore di Pubblica Istruzione</term>
    </label>
    <item>
        <gloss corresp="#Consiglio_Istr">Massimo organo consultivo del Ministero, incaricato di dare pareri sulle riforme e sulla disciplina dei professori.</gloss>
    </item>

    <label>
        <term type="org" xml:id="Rassegna">La Rassegna Settimanale</term>
    </label>
    <item>
        <gloss corresp="#Rassegna">Rivista di orientamento politico e culturale attiva nel periodo post-unitario.</gloss>
    </item>

    <label>
        <term type="political_party" xml:id="Destra">Destra Storica</term>
    </label>
    <item>
        <gloss corresp="#Destra">Fazione politica erede di Cavour, caratterizzata da un orientamento conservatore liberale.</gloss>
    </item>

    <label>
        <term type="political_party" xml:id="Sinistra">Sinistra Storica</term>
    </label>
    <item>
        <gloss corresp="#Sinistra">Schieramento politico di stampo liberal-progressista che salì al potere nel 1876.</gloss>
    </item>

    <label>
        <term type="political_party" xml:id="partito_conservatore">Partito conservatore</term>
    </label>
    <item>
        <gloss corresp="#partito_conservatore">Area politica che mirava alla conservazione delle istituzioni tradizionali; associata nel testo a Carlo Alfieri.</gloss>
    </item>

    <label>
        <term xml:id="democrazia_liberale">Democrazia liberale</term>
    </label>
    <item>
        <gloss corresp="#democrazia_liberale">Sistema politico basato sulla sovranità popolare e tutela delle libertà individuali.</gloss>
    </item>

    <label>
        <term xml:id="autoritarismo_democratico">Autoritarismo democratico</term>
    </label>
    <item>
        <gloss corresp="#autoritarismo_democratico">Definizione polemica per descrivere una gestione del potere centrale molto forte (riferito a Sella e Bertani).</gloss>
    </item>

    <label>
        <term xml:id="liberalismo">Liberalismo</term>
    </label>
    <item>
        <gloss corresp="#liberalismo">Dottrina politica basata sulla libertà individuale e limitazione del potere statale.</gloss>
    </item>

    <label>
        <term xml:id="democrazia">Democrazia</term>
    </label>
    <item>
        <gloss corresp="#democrazia">Forma di governo in cui il potere risiede nel popolo; analizzata nel testo in chiave critica.</gloss>
    </item>

    <label>
        <term type="law" xml:id="Legge_Casati">Legge Casati (1859)</term>
    </label>
    <item>
        <gloss corresp="#Legge_Casati">Riforma fondamentale della scuola italiana; stabilì l'obbligatorietà del primo biennio elementare.</gloss>
    </item>

    <label>
        <term type="law" xml:id="Statuto_Alb">Statuto Albertino</term>
    </label>
    <item>
        <gloss corresp="#Statuto_Alb">La carta costituzionale del Regno d'Italia.</gloss>
    </item>

    <label>
        <term type="object" xml:id="PAT_SUP">Diploma / Patente</term>
    </label>
    <item>
        <gloss corresp="#PAT_SUP">Titolo legale (patente) che abilita all'esercizio della professione di insegnante.</gloss>
    </item>

    <label>
        <term type="education" xml:id="istr_sup">Istruzione superiore</term>
    </label>
    <item>
        <gloss corresp="#istr_sup">Insegnamento scolastico che prosegue oltre il livello elementare di base.</gloss>
    </item>

    <label>
        <term xml:id="scuole_speciali">Scuole speciali</term>
    </label>
    <item>
        <gloss corresp="#scuole_speciali">Istituti professionalizzanti (come le Scuole Normali) per la preparazione a un mestiere specifico.</gloss>
    </item>

    <label>
        <term xml:id="scuole_cultura">Scuole di cultura generale</term>
    </label>
    <item>
        <gloss corresp="#scuole_cultura">Istituti (Ginnasi/Licei) volti a fornire un'istruzione umanistica o scientifica ampia.</gloss>
    </item>

    <label>
        <term xml:id="SNF">Scuole Normali Femminili</term>
    </label>
    <item>
        <gloss corresp="#SNF">Istituti per la formazione delle maestre elementari.</gloss>
    </item>

    <label>
        <term type="rhetoric" xml:id="ammazzatoi">Ammazzatoi</term>
    </label>
    <item>
        <gloss corresp="#ammazzatoi">Metafora iperbolica per denunciare l'insalubrità mortale delle aule.</gloss>
    </item>

    <label>
        <term type="hygiene" xml:id="stipate">Stivamento</term>
    </label>
    <item>
        <gloss corresp="#stipate">Sovraffollamento critico delle aule oltre i limiti igienici.</gloss>
    </item>

    <label>
        <term type="pathology" xml:id="soffocare">Asfissia / Spossatezza</term>
    </label>
    <item>
        <gloss corresp="#soffocare">Stato patologico derivante dalla mancanza di ossigeno nelle aule chiuse.</gloss>
    </item>

    <label>
        <term type="pathology" xml:id="pallida_magra_ricurva">Deperimento posturale</term>
    </label>
    <item>
        <gloss corresp="#pallida_magra_ricurva">Sindrome fisica (anemia e scoliosi) causata dall'ambiente scolastico malsano.</gloss>
    </item>

    <label>
        <term type="legal" xml:id="num_max">Limite legale (Capienza)</term>
    </label>
    <item>
        <gloss corresp="#num_max">Numero massimo di alunni consentito per aula dalle norme di sicurezza.</gloss>
    </item>

    <label>
        <term type="legal" xml:id="dovere">Responsabilità civile (Dovere)</term>
    </label>
    <item>
        <gloss corresp="#dovere">Obbligo delle autorità di garantire la salute degli studenti.</gloss>
    </item>

    <label>
        <term xml:id="industria_privata">Industria privata</term>
    </label>
    <item>
        <gloss corresp="#industria_privata">Settore economico gestito da privati, qui riferito alla gestione ferroviaria.</gloss>
    </item>
<label>
    <term type="org" xml:id="Consiglio_Istr">Consiglio Superiore di Pubblica Istruzione</term>
</label>
<item>
    <gloss corresp="#Consiglio_Istr">Organo consultivo del Ministero della Pubblica Istruzione. Nel testo è descritto come un ente indebolito dai ministri che spesso ne ignorano i pareri obbligatori.</gloss>
</item>

<label>
    <term type="org" xml:id="Camera">Camera dei Deputati</term>
</label>
<item>
    <gloss corresp="#Camera">Ramo del Parlamento dove viene discussa la politica scolastica e dove, secondo l'autore, il Consiglio Superiore viene spesso attaccato.</gloss>
</item>
<label>
    <term type="normativa" xml:id="Art_106">Articolo 106 (Legge Casati)</term>
</label>
<item>
    <gloss corresp="#Art_106">Disposizione che permetteva al Ministro di rimuovere i professori che insegnavano dottrine contrarie alla religione o alla morale dello Stato.</gloss>
</item>

<label>
    <term type="didattica" xml:id="licenza_liceale">Esame di Licenza Liceale</term>
</label>
<item>
    <gloss corresp="#licenza_liceale">Esame finale del liceo classico, necessario per l'accesso all'università. Il testo denuncia la continua variazione delle norme per favorire gli istituti privati.</gloss>
</item>

<label>
    <term type="valore" xml:id="liberta_scienza">Libertà della scienza e della coscienza</term>
</label>
<item>
    <gloss corresp="#liberta_scienza">Concetto cardine del pensiero liberale rivendicato dall'autore contro l'ingerenza religiosa e politica nell'insegnamento universitario.</gloss>
</item>

<label>
    <term type="atto_legale" xml:id="decreto_ministeriale">Decreto / Circolare</term>
</label>
<item>
    <gloss corresp="#decreto_ministeriale">Strumenti amministrativi rapidi usati dai ministri per modificare il sistema scolastico senza passare dal dibattito parlamentare (denunciati come causa di instabilità).</gloss>
</item>
<list type="glossary" xml:id="glossario_rassegna_notizie">
    <head>Glossario: Istituzioni, Scienza e Cultura</head>

    <label>
        <term type="org" xml:id="Inst_Archeo_Ger">Istituto archeologico germanico</term>
    </label>
    <item>
        <gloss corresp="#Inst_Archeo_Ger">Importante istituto di ricerca fondato a Roma nel 1829; nel testo si celebra il 50° anniversario della sua fondazione.</gloss>
    </item>

    <label>
        <term type="org" xml:id="Deputazione_BO">R. Deputazione di Storia patria di Bologna</term>
    </label>
    <item>
        <gloss corresp="#Deputazione_BO">Istituzione accademica dedicata alla ricerca, conservazione e pubblicazione di documenti relativi alla storia del territorio bolognese.</gloss>
    </item>

    <label>
        <term type="org" xml:id="Marciana">Biblioteca Marciana</term>
    </label>
    <item>
        <gloss corresp="#Marciana">Storica biblioteca di Venezia, citata nel testo per l'acquisto di un prezioso antifonario del XIV secolo.</gloss>
    </item>

    <label>
        <term type="org" xml:id="Conf_Carita">Confraternita della Carità</term>
    </label>
    <item>
        <gloss corresp="#Conf_Carita">Antica associazione laica veneziana (Scuola) che commissionò l'antifonario miniato descritto nel testo.</gloss>
    </item>

    <label>
        <term type="object" xml:id="Antifonario">Antifonario</term>
    </label>
    <item>
        <gloss corresp="#Antifonario">Libro liturgico che raccoglie le antifone e gli altri canti dell'ufficiatura divina; quello citato è in pergamena e riccamente miniato.</gloss>
    </item>

    <label>
        <term type="object" xml:id="cod">Codice (cod.)</term>
    </label>
    <item>
        <gloss corresp="#cod">Manoscritto antico in forma di libro; nel testo è riferito all'antifonario, definito "interessantissimo per la storia dell'arte".</gloss>
    </item>

    <label>
        <term type="project" xml:id="Spedizione_Imp">Spedizione Imperiale</term>
    </label>
    <item>
        <gloss corresp="#Spedizione_Imp">Missione esplorativa russa nell'Asia centrale con scopi scientifici (geologia, archeologia) e strategici (progettazione ferroviaria).</gloss>
    </item>

    <label>
        <term type="tech" xml:id="Amianthine">Amianthine</term>
    </label>
    <item>
        <gloss corresp="#Amianthine">Nuovo combustibile inventato dal signor Rocher, composto da polvere di amianto, carbone di legna e nitrato di piombo.</gloss>
    </item>

    <label>
        <term type="material" xml:id="amianto">Amianto</term>
    </label>
    <item>
        <gloss corresp="#amianto">Minerale a struttura fibrosa, qui citato come componente principale del nuovo combustibile "Amianthine".</gloss>
    </item>

    <label>
        <term type="discipline" xml:id="meteorologia">Meteorologia</term>
    </label>
    <item>
        <gloss corresp="#meteorologia">Branca della fisica che studia i fenomeni atmosferici; nel testo viene citata in relazione alla morte del prof. Dove, definito "padre" della disciplina.</gloss>
    </item>

    <label>
        <term type="journal" xml:id="Globe">The Globe</term>
    </label>
    <item>
        <gloss corresp="#Globe">Giornale britannico citato come fonte per i dettagli sulla spedizione russa in Asia centrale.</gloss>
    </item>

    <label>
        <term type="journal" xml:id="Nature">Nature</term>
    </label>
    <item>
        <gloss corresp="#Nature">Prestigiosa rivista scientifica britannica (fondata nel 1869) citata come fonte di notizie scientifiche.</gloss>
    </item>

</list>
    </standOff>
</teiCorpus>